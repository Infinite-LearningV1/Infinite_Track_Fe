# ===========================================
# INFINITE TRACK - Production Environment Example
# ===========================================
# Gunakan file ini sebagai contract build-time env untuk frontend static deploy.
# Semua nilai di file ini akan masuk ke bundle frontend, jadi HARUS public-safe.

# ===========================================
# API Configuration - WAJIB DIISI SAAT DEPLOY
# ===========================================
API_BASE_URL=https://api.infinite-track.tech
API_AUTH_ENDPOINT=/auth
API_VERSION=v1

# ===========================================
# Application Configuration
# ===========================================
APP_NAME=Infinite Track
APP_VERSION=2.0.1
APP_ENVIRONMENT=production

# ===========================================
# Authentication & Security
# ===========================================
SESSION_TIMEOUT=3600000
REMEMBER_ME_DAYS=7

# ===========================================
# Localization
# ===========================================
DEFAULT_LANGUAGE=id
TIMEZONE=Asia/Jakarta

# ===========================================
# Debug & Logging
# ===========================================
DEBUG_MODE=false
LOG_LEVEL=error
