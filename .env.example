# Environment Configuration Template
# ================================================
# Copy this file to .env for local development values.
# Semua nilai di file ini aman untuk frontend bundle dan bersifat public-safe.
# ================================================

# API Configuration
API_BASE_URL=/api
API_AUTH_ENDPOINT=/auth
API_VERSION=v1

# Application Configuration
APP_NAME=Infinite Track
APP_VERSION=2.0.1
APP_ENVIRONMENT=development

# Authentication Configuration
SESSION_TIMEOUT=3600000
REMEMBER_ME_DAYS=7

# Frontend Configuration
DEFAULT_LANGUAGE=id
TIMEZONE=Asia/Jakarta

# Debug Configuration
DEBUG_MODE=true
LOG_LEVEL=info
